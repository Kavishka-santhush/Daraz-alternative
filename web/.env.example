# ── API backend ────────────────────────────────────────────────
# Base URL of the Express API (server/) — used client- and server-side.
NEXT_PUBLIC_API_URL=http://localhost:5000
# Socket.io server URL (realtime notifications / chat).
NEXT_PUBLIC_SOCKET_URL=http://localhost:5000
# Public URL of this web app (used for OAuth redirects / share links).
NEXT_PUBLIC_WEB_URL=http://localhost:3000
# Default currency + symbol used as a fallback before settings load.
NEXT_PUBLIC_CURRENCY=LKR
NEXT_PUBLIC_CURRENCY_SYMBOL=Rs

# ── Stripe (client) ────────────────────────────────────────────
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_placeholder

# ── Web Push (VAPID public key — must match server) ─────────────
NEXT_PUBLIC_VAPID_PUBLIC_KEY=

# ── NextAuth (server-side only) ────────────────────────────────
# Generate with: openssl rand -base64 32
NEXTAUTH_SECRET=change-me-in-production
NEXTAUTH_URL=http://localhost:3000

# ── OAuth (optional — credentials login works without these) ───
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
FACEBOOK_CLIENT_ID=
FACEBOOK_CLIENT_SECRET=
# Set to true ONLY when the matching server credentials above are configured —
# controls whether the social login buttons render in the browser.
NEXT_PUBLIC_GOOGLE_LOGIN_ENABLED=false
NEXT_PUBLIC_FACEBOOK_LOGIN_ENABLED=false
