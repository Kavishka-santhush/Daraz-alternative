{
  "name": "marketplace-server",
  "version": "1.0.0",
  "description": "Multi-vendor e-commerce marketplace REST API (Daraz alternative)",
  "main": "dist/index.js",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/index.js",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "prisma migrate dev",
    "prisma:deploy": "prisma migrate deploy",
    "db:seed": "tsx prisma/seeds/index.ts",
    "lint": "eslint src --ext .ts"
  },
  "prisma": {
    "seed": "tsx prisma/seeds/index.ts"
  },
  "dependencies": {
    "@prisma/client": "^5.19.1",
    "@react-email/components": "^0.0.21",
    "@react-email/render": "^0.0.16",
    "bcryptjs": "^2.4.3",
    "compression": "^1.7.4",
    "cookie-parser": "^1.4.6",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "express-rate-limit": "^7.4.0",
    "helmet": "^7.1.0",
    "jsonwebtoken": "^9.0.2",
    "multer": "^1.4.5-lts.1",
    "nodemailer": "^6.9.14",
    "openai": "^4.56.0",
    "pdfkit": "^0.15.0",
    "puppeteer": "^22.15.0",
    "socket.io": "^4.7.5",
    "stripe": "^16.8.0",
    "uuid": "^9.0.1",
    "web-push": "^3.6.7",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/compression": "^1.7.5",
    "@types/cookie-parser": "^1.4.7",
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/jsonwebtoken": "^9.0.6",
    "@types/multer": "^1.4.11",
    "@types/node": "^20.14.11",
    "@types/nodemailer": "^6.4.15",
    "@types/uuid": "^9.0.8",
    "@types/web-push": "^3.6.3",
    "prisma": "^5.19.1",
    "tsx": "^4.16.2",
    "typescript": "^5.5.3"
  }
}
