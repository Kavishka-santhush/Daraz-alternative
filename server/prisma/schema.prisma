// Multi-Vendor E-Commerce Marketplace — Prisma schema (PostgreSQL)
// Note: pg_trgm extension + full-text indexes are created in migration SQL
// (prisma/migrations/0002_add_pg_trgm_search/index.ts-style raw SQL files).

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ─────────────────────────── ENUMS ───────────────────────────

enum UserRole {
  SUPER_ADMIN
  ADMIN
  OPERATIONS_MANAGER
  SUPPORT_AGENT
  FINANCE_MANAGER
  SELLER
  BUYER
}

enum UserStatus {
  PENDING_VERIFICATION
  ACTIVE
  SUSPENDED
  BANNED
  DELETED
}

enum SellerStatus {
  PENDING_APPROVAL
  APPROVED
  REJECTED
  SUSPENDED
}

enum SellerTier {
  NEW
  BRONZE
  SILVER
  GOLD
  PLATINUM
}

enum DocumentType {
  BUSINESS_REGISTRATION
  NIC_FRONT
  NIC_BACK
  PASSPORT
  TAX_REGISTERATION
  BANK_STATEMENT
  SHOP_LOGO
  SHOP_COVER
  AVATAR
  PRODUCT_IMAGE
  RETURN_PROOF
  OTHER
}

enum DocumentStatus {
  PENDING
  APPROVED
  REJECTED
}

enum ProductStatus {
  DRAFT
  PENDING_REVIEW
  ACTIVE
  REJECTED
  ARCHIVED
  OUT_OF_STOCK
}

enum ProductCondition {
  NEW
  REFURBISHED
  USED
}

enum ShippingClass {
  SMALL
  MEDIUM
  LARGE
  HEAVY
  FRAGILE
}

enum OrderStatus {
  PLACED
  CONFIRMED
  PROCESSING
  SHIPPED
  OUT_FOR_DELIVERY
  DELIVERED
  CANCELLED
  RETURN_REQUESTED
  RETURNED
  REFUNDED
}

enum PaymentMethod {
  CARD
  WALLET
  COD
  INSTALLMENTS
}

enum PaymentStatus {
  PENDING
  PROCESSING
  SUCCEEDED
  FAILED
  REFUNDED
  PARTIALLY_REFUNDED
  CANCELLED
}

enum PaymentPurpose {
  ORDER
  WALLET_TOPUP
  SPONSORED_LISTING
  SHIPPING
}

enum InstallmentPlanType {
  MONTH_3
  MONTH_6
  MONTH_12
}

enum InstallmentStatus {
  DUE
  PAID
  OVERDUE
  UPFRONT
}

enum ReturnStatus {
  REQUESTED
  APPROVED
  REJECTED
  ITEM_RETURNED
  REFUND_INITIATED
  REFUND_COMPLETED
  CANCELLED
}

enum DisputeStatus {
  OPEN
  ASSIGNED
  IN_PROGRESS
  RESOLVED
  REJECTED
}

enum VoucherType {
  PERCENT
  FIXED
  FREE_SHIPPING
}

enum VoucherScope {
  PLATFORM
  SELLER
}

enum VoucherStatus {
  ACTIVE
  SCHEDULED
  EXPIRED
  DEACTIVATED
}

enum RewardType {
  POINTS
  COINS
  CASHBACK
}

enum TransactionType {
  CREDIT
  DEBIT
}

enum WalletTxPurpose {
  TOPUP
  ORDER_PAYMENT
  ORDER_REFUND
  PAYOUT
  ADJUSTMENT
  CASHBACK
  LOYALTY_REDEEM
}

enum PayoutStatus {
  REQUESTED
  APPROVED
  REJECTED
  PROCESSED
}

enum NotificationChannel {
  IN_APP
  EMAIL
  PUSH
}

enum NotificationAudience {
  BUYER
  SELLER
  ADMIN
  ALL
}

enum TicketStatus {
  OPEN
  IN_PROGRESS
  RESOLVED
  CLOSED
}

enum TicketPriority {
  LOW
  MEDIUM
  HIGH
  URGENT
}

enum TicketType {
  ORDER
  RETURN
  REFUND
  PRODUCT
  PAYMENT
  ACCOUNT
  OTHER
}

enum StockChangeType {
  SALE
  CANCELLATION
  RESTOCK
  RESERVATION
  ADJUSTMENT
  RETURN
  BULK_UPDATE
}

enum SponsoredPaymentStatus {
  UNPAID
  PAID
  REFUNDED
  EXPIRED
}

enum FraudSubject {
  ORDER
  SELLER
  BUYER
  REVIEW
  TRANSACTION
}

enum FraudStatus {
  FLAGGED
  REVIEWING
  CLEARED
  ACTION_TAKEN
}

enum ReferenceEntityType {
  ORDER
  SUB_ORDER
  PRODUCT
  RETURN
  PAYOUT
  VOUCHER
  USER
  SHOP
  SELLER
  TICKET
  SYSTEM
}

enum AuditEntityType {
  USER
  SELLER
  SHOP
  PRODUCT
  CATEGORY
  BRAND
  ORDER
  SUB_ORDER
  RETURN
  PAYMENT
  VOUCHER
  FLASH_SALE
  BANNER
  PAYOUT
  TICKET
  SETTINGS
  REVIEW
  SPONSORED_LISTING
}

enum AnnouncementPlacement {
  SITE_WIDE_BANNER
  NOTIFICATION
  HOMEPAGE_MODAL
}

enum AttributeType {
  TEXT
  SELECT
  NUMBER
  BOOLEAN
  RANGE
}

// ─────────────────────────── AUTH & USERS ───────────────────────────

model User {
  id               String        @id @default(cuid())
  email            String        @unique
  phone            String?       @unique
  passwordHash     String?
  name             String
  avatarUrl        String?
  role             UserRole      @default(BUYER)
  status           UserStatus    @default(PENDING_VERIFICATION)
  emailVerifiedAt  DateTime?
  phoneVerifiedAt  DateTime?
  referralCode     String        @unique @default(cuid())
  referredById     String?
  referredBy       User?         @relation("UserReferral", fields: [referredById], references: [id])
  referralsMade    User[]        @relation("UserReferral")
  wallet           Wallet?
  loyaltyPoints    Int           @default(0)
  coins            Int           @default(0)
  sellerProfile    SellerProfile?
  addresses        Address[]
  carts            Cart[]
  orders           Order[]       @relation("BuyerOrders")
  reviews          Review[]
  reviewMedia      ReviewMedia[]
  helpfulVotes     ReviewHelpful[]
  qaAsked          ProductQa[]   @relation("QaAskedBy")
  qaAnswered       ProductQa[]   @relation("QaAnsweredBy")
  wishlists        WishlistItem[]
  notifications    Notification[]
  notifPrefs       NotificationPreference[]
  pushSubs         PushSubscription[]
  tickets          SupportTicket[] @relation("TicketCreator")
  assignedTickets  SupportTicket[] @relation("TicketAssignee")
  ticketMessages   TicketMessage[]
  auditLogs        AuditLog[]
  loginHistory     LoginActivity[]
  refreshTokens    RefreshToken[]
  resetTokens      PasswordResetToken[]
  walletTx         WalletTransaction[] @relation("WalletTxActor")
  chatSessions     AiChatSession[]
  searchQueries    SearchQuery[]
  productViews     ProductView[]
  returnRequests   ReturnRequest[]
  loyaltyLedger    LoyaltyLedger[]
  referralRewardsGiven    ReferralReward[]  @relation("ReferralReferrer")
  referralRewardsReceived ReferralReward[]  @relation("ReferralReferee")
  followingShops   Shop[]
  deviceInfo       Json?
  lastLoginAt      DateTime?
  createdAt        DateTime      @default(now())
  updatedAt        DateTime      @updatedAt

  @@index([role, status])
  @@index([referredById])
}

model RefreshToken {
  id        String    @id @default(cuid())
  tokenHash String    @unique
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  deviceId  String?
  ip        String?
  userAgent String?
  expiresAt DateTime
  revokedAt DateTime?
  replacedById String?
  createdAt DateTime  @default(now())

  @@index([userId])
}

model PasswordResetToken {
  id        String    @id @default(cuid())
  tokenHash String    @unique
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([userId])
}

model OtpCode {
  id        String    @id @default(cuid())
  phone     String
  codeHash  String
  purpose   String    @default("PHONE_VERIFICATION")
  expiresAt DateTime
  verifiedAt DateTime?
  attempts  Int       @default(0)
  createdAt DateTime  @default(now())

  @@index([phone, purpose])
}

model LoginActivity {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  ip        String?
  userAgent String?
  deviceId  String?
  success   Boolean  @default(true)
  method    String   @default("PASSWORD")
  createdAt DateTime @default(now())

  @@index([userId, createdAt])
}

model Address {
  id            String   @id @default(cuid())
  userId        String
  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  label         String?
  contactName   String
  contactPhone  String
  line1         String
  line2         String?
  city          String
  district      String?
  province      String?
  postalCode    String?
  isDefault     Boolean  @default(false)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@index([userId])
}

// ─────────────────────────── SELLERS & SHOPS ───────────────────────────

model SellerProfile {
  id                   String       @id @default(cuid())
  userId               String       @unique
  user                 User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  status               SellerStatus @default(PENDING_APPROVAL)
  tier                 SellerTier   @default(NEW)
  isVerified           Boolean      @default(false)
  rejectionReason      String?
  approvedAt           DateTime?
  approvedById         String?
  suspensionReason     String?
  suspendedAt          DateTime?
  commissionOverride   Decimal?     @db.Decimal(5, 2)
  payoutBank           Json?
  rating               Decimal      @default(0) @db.Decimal(4, 2)
  totalOrders          Int          @default(0)
  completedOrders      Int          @default(0)
  cancelledOrders      Int          @default(0)
  disputeCount         Int          @default(0)
  avgResponseHours     Decimal      @default(0) @db.Decimal(6, 2)
  shops                Shop[]
  documents            BusinessDocument[]
  warehouses           Warehouse[]
  vouchers             Voucher[]
  payoutRequests       PayoutRequest[]
  earnings             SellerEarnings[]
  sponsoredListings    SponsoredListing[]
  createdAt            DateTime     @default(now())
  updatedAt            DateTime     @updatedAt

  @@index([status, tier])
}

model Shop {
  id                  String        @id @default(cuid())
  sellerId            String
  seller              SellerProfile @relation(fields: [sellerId], references: [id], onDelete: Cascade)
  name                String
  slug                String        @unique
  description         String?
  logoUrl             String?
  coverUrl            String?
  policyReturn        String?
  policyShipping      String?
  policyWarranty      String?
  operatingHours      Json?
  shippingOrigin      String?
  defaultDeliveryDays Int           @default(5)
  isActive            Boolean       @default(true)
  products            Product[]
  subOrders           SellerSubOrder[]
  followers           User[]
  createdAt           DateTime      @default(now())
  updatedAt           DateTime      @updatedAt

  @@index([sellerId])
  @@index([isActive])
}

model BusinessDocument {
  id          String         @id @default(cuid())
  sellerId    String
  seller      SellerProfile  @relation(fields: [sellerId], references: [id], onDelete: Cascade)
  type        DocumentType
  fileName    String
  url         String
  number      String?
  expiryDate  DateTime?
  status      DocumentStatus @default(PENDING)
  reviewNote  String?
  reviewedById String?
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt

  @@index([sellerId, status])
}

model Warehouse {
  id        String        @id @default(cuid())
  sellerId  String
  seller    SellerProfile @relation(fields: [sellerId], references: [id], onDelete: Cascade)
  name      String
  address   String
  city      String
  province  String?
  isDefault Boolean       @default(false)
  isActive  Boolean       @default(true)
  movements StockMovement[]
  createdAt DateTime      @default(now())
  updatedAt DateTime      @updatedAt

  @@index([sellerId])
}

model SellerEarnings {
  id              String        @id @default(cuid())
  sellerId        String
  seller          SellerProfile @relation(fields: [sellerId], references: [id], onDelete: Cascade)
  grossRevenue    Decimal       @default(0) @db.Decimal(14, 2)
  commissionPaid  Decimal       @default(0) @db.Decimal(14, 2)
  netEarnings     Decimal       @default(0) @db.Decimal(14, 2)
  available       Decimal       @default(0) @db.Decimal(14, 2)
  pending         Decimal       @default(0) @db.Decimal(14, 2)
  withdrawn       Decimal       @default(0) @db.Decimal(14, 2)
  periodStart     DateTime
  periodEnd       DateTime
  createdAt       DateTime      @default(now())

  @@unique([sellerId, periodStart, periodEnd])
  @@index([sellerId])
}

// ─────────────────────────── TAXONOMY ───────────────────────────

model Category {
  id                String     @id @default(cuid())
  parentId          String?
  parent            Category?  @relation("CategoryTree", fields: [parentId], references: [id])
  children          Category[] @relation("CategoryTree")
  name              String
  slug              String     @unique
  iconUrl           String?
  bannerUrl         String?
  description       String?
  level             Int        @default(1)
  path              String     @default("")
  commissionPercent Decimal    @default(8) @db.Decimal(5, 2)
  returnWindowDays  Int        @default(7)
  isFeatured        Boolean    @default(false)
  isActive          Boolean    @default(true)
  sortOrder         Int        @default(0)
  metaTitle         String?
  metaDescription   String?
  attributes        Attribute[]
  brands            Brand[]
  products          Product[]
  vouchers          Voucher[]  @relation("VoucherCategories")
  createdAt         DateTime   @default(now())
  updatedAt         DateTime   @updatedAt

  @@index([parentId])
  @@index([isActive, isFeatured])
}

model Attribute {
  id         String            @id @default(cuid())
  categoryId String
  category   Category          @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  name       String
  slug       String
  type       AttributeType     @default(SELECT)
  isRequired Boolean           @default(false)
  sortOrder  Int               @default(0)
  values     AttributeValue[]
  variantLinks VariantAttributeValue[]
  createdAt  DateTime          @default(now())
  updatedAt  DateTime          @updatedAt

  @@unique([categoryId, slug])
}

model AttributeValue {
  id          String      @id @default(cuid())
  attributeId String
  attribute   Attribute   @relation(fields: [attributeId], references: [id], onDelete: Cascade)
  value       String
  sortOrder   Int         @default(0)
  createdAt   DateTime    @default(now())

  @@index([attributeId])
}

model Brand {
  id             String     @id @default(cuid())
  categoryId     String?
  category       Category?  @relation(fields: [categoryId], references: [id])
  name           String
  slug           String     @unique
  logoUrl        String?
  description    String?
  isActive       Boolean    @default(true)
  isFeatured     Boolean    @default(false)
  products       Product[]
  createdAt      DateTime   @default(now())
  updatedAt      DateTime   @updatedAt

  @@index([categoryId])
}

// ─────────────────────────── PRODUCTS ───────────────────────────

model Product {
  id                String           @id @default(cuid())
  shopId            String
  shop              Shop             @relation(fields: [shopId], references: [id], onDelete: Cascade)
  categoryId        String
  category          Category         @relation(fields: [categoryId], references: [id])
  brandId           String?
  brand             Brand?           @relation(fields: [brandId], references: [id])
  title             String
  slug              String           @unique
  subtitle          String?
  description       String
  richDescription   Json?
  tags              String[]
  condition         ProductCondition @default(NEW)
  status            ProductStatus    @default(DRAFT)
  sku               String           @unique
  originalPrice     Decimal          @db.Decimal(12, 2)
  salePrice         Decimal?         @db.Decimal(12, 2)
  discountPercent   Decimal          @default(0) @db.Decimal(5, 2)
  stockQuantity     Int              @default(0)
  lowStockThreshold Int              @default(5)
  soldCount         Int              @default(0)
  viewCount         Int              @default(0)
  ratingAverage     Decimal          @default(0) @db.Decimal(3, 2)
  ratingCount       Int              @default(0)
  weightGrams       Int?
  lengthCm          Decimal?         @db.Decimal(8, 2)
  widthCm           Decimal?         @db.Decimal(8, 2)
  heightCm          Decimal?         @db.Decimal(8, 2)
  shippingClass     ShippingClass    @default(SMALL)
  videoUrl          String?
  metaTitle         String?
  metaDescription   String?
  seoKeywords       String?
  moderationNote    String?
  reviewedById      String?
  reviewedAt        DateTime?
  dealStartsAt      DateTime?
  dealEndsAt        DateTime?
  isFeatured        Boolean          @default(false)
  attributes        Json?
  images            ProductImage[]
  variants          ProductVariant[]
  reviews           Review[]
  qa                ProductQa[]
  wishlistItems     WishlistItem[]
  stockMovements    StockMovement[]
  cartItems         CartItem[]
  orderItems        OrderItem[]
  flashSaleItems    FlashSaleItem[]
  bundleItems       BundleDealItem[]
  sponsored         SponsoredListing[]
  returnItems       ReturnItem[]
  productViews      ProductView[]
  createdAt         DateTime         @default(now())
  updatedAt         DateTime         @updatedAt

  @@index([shopId, status])
  @@index([categoryId, status])
  @@index([brandId])
  @@index([status, isFeatured])
  @@index([soldCount])
  @@index([ratingAverage])
  @@index([dealEndsAt])
}

model ProductImage {
  id        String   @id @default(cuid())
  productId String
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  url       String
  altText   String?
  position  Int      @default(0)
  isPrimary Boolean  @default(false)
  createdAt DateTime @default(now())

  @@index([productId])
}

model ProductVariant {
  id            String          @id @default(cuid())
  productId     String
  product       Product         @relation(fields: [productId], references: [id], onDelete: Cascade)
  name          String
  sku           String          @unique
  optionLabel   String?
  price         Decimal         @db.Decimal(12, 2)
  compareAtPrice Decimal?       @db.Decimal(12, 2)
  stockQuantity Int             @default(0)
  attributeValues VariantAttributeValue[]
  orderItems    OrderItem[]
  isActive      Boolean         @default(true)
  createdAt     DateTime        @default(now())
  updatedAt     DateTime        @updatedAt

  @@index([productId])
}

model VariantAttributeValue {
  id             String            @id @default(cuid())
  variantId      String
  variant        ProductVariant    @relation(fields: [variantId], references: [id], onDelete: Cascade)
  attributeId    String
  attribute      Attribute         @relation(fields: [attributeId], references: [id])
  attributeValue String
  createdAt      DateTime          @default(now())

  @@index([variantId])
  @@index([attributeId])
}

model StockMovement {
  id            String           @id @default(cuid())
  productId     String
  product       Product          @relation(fields: [productId], references: [id])
  variantId     String?
  warehouseId   String?
  warehouse     Warehouse?       @relation(fields: [warehouseId], references: [id])
  changeType    StockChangeType
  quantityDelta Int
  quantityBefore Int
  quantityAfter  Int
  referenceType ReferenceEntityType?
  referenceId   String?
  reason        String?
  actorId       String?
  createdAt     DateTime         @default(now())

  @@index([productId, createdAt])
  @@index([warehouseId])
}

model ProductQa {
  id         String    @id @default(cuid())
  productId  String
  product    Product   @relation(fields: [productId], references: [id], onDelete: Cascade)
  askedById  String
  askedBy    User      @relation("QaAskedBy", fields: [askedById], references: [id])
  question   String
  answer     String?
  answeredById String?
  answeredBy User?     @relation("QaAnsweredBy", fields: [answeredById], references: [id])
  answeredAt DateTime?
  isVisible  Boolean   @default(true)
  isPublic   Boolean   @default(true)
  createdAt  DateTime  @default(now())

  @@index([productId, isVisible])
}

// ─────────────────────────── CART & ORDERS ───────────────────────────

model Cart {
  id        String     @id @default(cuid())
  userId    String
  user      User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  items     CartItem[]
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt

  @@index([userId])
}

model CartItem {
  id        String          @id @default(cuid())
  cartId    String
  cart      Cart            @relation(fields: [cartId], references: [id], onDelete: Cascade)
  productId String
  product   Product         @relation(fields: [productId], references: [id], onDelete: Cascade)
  variantId String?
  quantity  Int             @default(1)
  voucherCode String?
  giftNote  String?
  addedAt   DateTime        @default(now())

  @@unique([cartId, productId, variantId])
  @@index([cartId])
}

model Order {
  id                 String          @id @default(cuid())
  orderNumber        String          @unique
  buyerId            String
  buyer              User            @relation("BuyerOrders", fields: [buyerId], references: [id])
  addressSnapshot    Json
  addressId          String?
  paymentMethod      PaymentMethod
  paymentStatus      PaymentStatus   @default(PENDING)
  status             OrderStatus     @default(PLACED)
  subtotal           Decimal         @db.Decimal(14, 2)
  shippingTotal      Decimal         @default(0) @db.Decimal(12, 2)
  discountTotal      Decimal         @default(0) @db.Decimal(12, 2)
  taxTotal           Decimal         @default(0) @db.Decimal(12, 2)
  totalAmount        Decimal         @db.Decimal(14, 2)
  paidAmount         Decimal         @default(0) @db.Decimal(14, 2)
  refundedAmount     Decimal         @default(0) @db.Decimal(14, 2)
  walletUsed         Decimal         @default(0) @db.Decimal(14, 2)
  loyaltyPointsEarned Int            @default(0)
  loyaltyPointsRedeemed Int          @default(0)
  buyerNotes         String?
  voucherCodesUsed   String[]
  cancelReason       String?
  cancelledAt        DateTime?
  deliveredAt        DateTime?
  invoiceUrl         String?
  payments           Payment[]
  subOrders          SellerSubOrder[]
  events             OrderEvent[]
  installmentPlanType InstallmentPlanType?
  createdAt          DateTime        @default(now())
  updatedAt          DateTime        @updatedAt

  @@index([buyerId, status])
  @@index([paymentStatus])
  @@index([createdAt])
}

model SellerSubOrder {
  id                    String      @id @default(cuid())
  subOrderNumber        String      @unique
  orderId               String
  order                 Order       @relation(fields: [orderId], references: [id], onDelete: Cascade)
  shopId                String
  shop                  Shop        @relation(fields: [shopId], references: [id])
  sellerId              String
  status                OrderStatus @default(PLACED)
  subtotal              Decimal     @db.Decimal(14, 2)
  shippingFee           Decimal     @default(0) @db.Decimal(12, 2)
  discountAmount        Decimal     @default(0) @db.Decimal(12, 2)
  commissionPercent     Decimal     @db.Decimal(5, 2)
  commissionAmount      Decimal     @default(0) @db.Decimal(12, 2)
  sellerEarning         Decimal     @default(0) @db.Decimal(14, 2)
  trackingNumber        String?
  courierName           String?
  estimatedDispatchAt   DateTime?
  estimatedDeliveryAt   DateTime?
  confirmedAt           DateTime?
  shippedAt             DateTime?
  deliveredAt           DateTime?
  cancelledAt           DateTime?
  autoCancelledAt       DateTime?
  sellerNotes           String?
  items                 OrderItem[]
  events                OrderEvent[]
  returnRequests        ReturnRequest[]
  createdAt             DateTime    @default(now())
  updatedAt             DateTime    @updatedAt

  @@index([orderId])
  @@index([shopId, status])
  @@index([sellerId, status])
  @@index([status, createdAt])
}

model OrderItem {
  id            String          @id @default(cuid())
  subOrderId    String
  subOrder      SellerSubOrder  @relation(fields: [subOrderId], references: [id], onDelete: Cascade)
  productId     String
  product       Product         @relation(fields: [productId], references: [id])
  variantId     String?
  variant       ProductVariant? @relation(fields: [variantId], references: [id])
  titleSnapshot String
  imageSnapshot String?
  unitPrice     Decimal         @db.Decimal(12, 2)
  quantity      Int
  totalPrice    Decimal         @db.Decimal(14, 2)
  discountAmount Decimal        @default(0) @db.Decimal(12, 2)
  returnRequests ReturnItem[]
  createdAt     DateTime        @default(now())

  @@index([subOrderId])
  @@index([productId])
}

model OrderEvent {
  id          String         @id @default(cuid())
  orderId     String?
  order       Order?         @relation(fields: [orderId], references: [id], onDelete: Cascade)
  subOrderId  String?
  subOrder    SellerSubOrder? @relation(fields: [subOrderId], references: [id], onDelete: Cascade)
  status      OrderStatus?
  title       String
  description String?
  actorType   String         @default("SYSTEM")
  actorId     String?
  createdAt   DateTime       @default(now())

  @@index([orderId, createdAt])
  @@index([subOrderId, createdAt])
}

// ─────────────────────────── RETURNS & DISPUTES ───────────────────────────

model ReturnRequest {
  id              String        @id @default(cuid())
  returnNumber    String        @unique
  subOrderId      String
  subOrder        SellerSubOrder @relation(fields: [subOrderId], references: [id])
  buyerId         String?
  buyer           User?         @relation(fields: [buyerId], references: [id])
  reason          String
  description     String?
  status          ReturnStatus  @default(REQUESTED)
  requestedRefund Decimal       @db.Decimal(14, 2)
  approvedRefund  Decimal?      @db.Decimal(14, 2)
  isPartial       Boolean       @default(false)
  refundMethod    String?
  sellerDecidedAt DateTime?
  sellerNote      String?
  adminNote       String?
  evidence        Json?
  returnLabelUrl  String?
  refundTxId      String?
  items           ReturnItem[]
  dispute         Dispute?
  events          ReturnEvent[]
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  @@index([subOrderId])
  @@index([status, createdAt])
}

model ReturnItem {
  id             String        @id @default(cuid())
  returnId       String
  returnRequest  ReturnRequest @relation(fields: [returnId], references: [id], onDelete: Cascade)
  orderItemId    String
  orderItem      OrderItem     @relation(fields: [orderItemId], references: [id])
  productId      String
  product        Product       @relation(fields: [productId], references: [id])
  quantity       Int
  reason         String?
  createdAt      DateTime      @default(now())

  @@index([returnId])
}

model ReturnEvent {
  id        String        @id @default(cuid())
  returnId  String
  request   ReturnRequest @relation(fields: [returnId], references: [id], onDelete: Cascade)
  status    ReturnStatus
  note      String?
  actorType String        @default("SYSTEM")
  actorId   String?
  createdAt DateTime      @default(now())

  @@index([returnId, createdAt])
}

model Dispute {
  id            String        @id @default(cuid())
  returnId      String        @unique
  returnRequest ReturnRequest @relation(fields: [returnId], references: [id])
  openedById    String?
  assignedToId  String?
  status        DisputeStatus @default(OPEN)
  resolution    String?
  resolvedById  String?
  resolvedAt    DateTime?
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt

  @@index([status])
}

// ─────────────────────────── PAYMENTS ───────────────────────────

model Payment {
  id              String           @id @default(cuid())
  orderId         String?
  order           Order?           @relation(fields: [orderId], references: [id])
  buyerId         String?
  method          PaymentMethod
  purpose         PaymentPurpose   @default(ORDER)
  amount          Decimal          @db.Decimal(14, 2)
  currency        String           @default("LKR")
  status          PaymentStatus    @default(PENDING)
  stripePaymentIntentId String?    @unique
  stripeChargeId  String?
  failureReason   String?
  retryCount      Int              @default(0)
  walletTxId      String?
  refundedAmount  Decimal          @default(0) @db.Decimal(14, 2)
  paidAt          DateTime?
  metadata        Json?
  installments    InstallmentPlan?
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt

  @@index([orderId])
  @@index([status, createdAt])
  @@index([stripePaymentIntentId])
}

model InstallmentPlan {
  id            String            @id @default(cuid())
  paymentId     String          @unique
  payment       Payment           @relation(fields: [paymentId], references: [id])
  orderId       String?
  planType      InstallmentPlanType
  totalAmount   Decimal           @db.Decimal(14, 2)
  upfrontAmount Decimal           @default(0) @db.Decimal(14, 2)
  installmentAmount Decimal       @db.Decimal(14, 2)
  tenureMonths  Int
  interestRate  Decimal           @default(0) @db.Decimal(5, 2)
  records       InstallmentRecord[]
  createdAt     DateTime          @default(now())
  updatedAt     DateTime          @updatedAt

  @@index([orderId])
}

model InstallmentRecord {
  id         String          @id @default(cuid())
  planId     String
  plan       InstallmentPlan @relation(fields: [planId], references: [id], onDelete: Cascade)
  indexNo    Int
  dueDate    DateTime
  amount     Decimal         @db.Decimal(14, 2)
  status     InstallmentStatus @default(DUE)
  paidAt     DateTime?
  paymentRef String?
  createdAt  DateTime        @default(now())

  @@unique([planId, indexNo])
  @@index([status, dueDate])
}

model Wallet {
  id         String              @id @default(cuid())
  userId     String              @unique
  user       User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  balance    Decimal             @default(0) @db.Decimal(14, 2)
  currency   String              @default("LKR")
  isFrozen   Boolean             @default(false)
  transactions WalletTransaction[]
  createdAt  DateTime            @default(now())
  updatedAt  DateTime            @updatedAt
}

model WalletTransaction {
  id          String           @id @default(cuid())
  walletId    String
  wallet      Wallet           @relation(fields: [walletId], references: [id], onDelete: Cascade)
  type        TransactionType
  purpose     WalletTxPurpose
  amount      Decimal          @db.Decimal(14, 2)
  balanceAfter Decimal         @db.Decimal(14, 2)
  referenceType ReferenceEntityType?
  referenceId String?
  description String?
  actorId     String?
  actor       User?            @relation("WalletTxActor", fields: [actorId], references: [id])
  createdAt   DateTime         @default(now())

  @@index([walletId, createdAt])
}

model PayoutRequest {
  id              String        @id @default(cuid())
  payoutNumber    String        @unique
  sellerId        String
  seller          SellerProfile @relation(fields: [sellerId], references: [id])
  amount          Decimal       @db.Decimal(14, 2)
  currency        String        @default("LKR")
  bankName        String
  bankAccountNo   String
  bankBranch      String?
  accountHolder   String
  status          PayoutStatus  @default(REQUESTED)
  reviewedById    String?
  processedAt     DateTime?
  rejectionReason String?
  stripeTransferId String?
  referenceNote   String?
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  @@index([sellerId, status])
  @@index([status, createdAt])
}

model CommissionRule {
  id          String   @id @default(cuid())
  categoryId  String?
  sellerTier  SellerTier?
  percent     Decimal  @db.Decimal(5, 2)
  isBaseline  Boolean  @default(false)
  updatedById String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@unique([categoryId, sellerTier])
}

// ─────────────────────────── PROMOTIONS ───────────────────────────

model Voucher {
  id                 String        @id @default(cuid())
  code               String        @unique
  name               String
  description        String?
  scope              VoucherScope
  type               VoucherType
  ownerId            String?
  owner              SellerProfile? @relation(fields: [ownerId], references: [id])
  createdByStaffId   String?
  percentOff         Decimal?      @db.Decimal(5, 2)
  fixedOff           Decimal?      @db.Decimal(12, 2)
  maxDiscount        Decimal?      @db.Decimal(12, 2)
  minOrderAmount     Decimal?      @db.Decimal(12, 2)
  applicableCategories Category[]  @relation("VoucherCategories")
  applicableProducts String[]
  newBuyersOnly      Boolean       @default(false)
  oneTimePerUser     Boolean       @default(true)
  usageLimit         Int?
  usedCount          Int           @default(0)
  status             VoucherStatus @default(ACTIVE)
  startsAt           DateTime
  expiresAt          DateTime
  targetUrl          String?
  usages             VoucherUsage[]
  createdAt          DateTime      @default(now())
  updatedAt          DateTime      @updatedAt

  @@index([scope, status])
  @@index([ownerId])
}

model VoucherUsage {
  id          String   @id @default(cuid())
  voucherId   String
  voucher     Voucher  @relation(fields: [voucherId], references: [id], onDelete: Cascade)
  userId      String
  orderId     String?
  discountApplied Decimal @db.Decimal(12, 2)
  usedAt      DateTime @default(now())

  @@index([voucherId, userId])
}

model FlashSale {
  id          String          @id @default(cuid())
  title       String
  slug        String          @unique
  description String?
  bannerUrl   String?
  startsAt    DateTime
  endsAt      DateTime
  isActive    Boolean         @default(true)
  status      String          @default("SCHEDULED")
  createdById String?
  items       FlashSaleItem[]
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt

  @@index([isActive, startsAt, endsAt])
}

model FlashSaleItem {
  id            String    @id @default(cuid())
  flashSaleId   String
  flashSale     FlashSale @relation(fields: [flashSaleId], references: [id], onDelete: Cascade)
  productId     String
  product       Product   @relation(fields: [productId], references: [id], onDelete: Cascade)
  salePrice     Decimal   @db.Decimal(12, 2)
  stockLimit    Int       @default(0)
  soldCount     Int       @default(0)
  sortOrder     Int       @default(0)
  createdAt     DateTime  @default(now())

  @@unique([flashSaleId, productId])
  @@index([productId])
}

model BundleDeal {
  id            String           @id @default(cuid())
  shopId        String?
  title         String
  description   String?
  dealType      String
  buyQuantity   Int              @default(2)
  getConfigQty  Int              @default(1)
  discountPercent Decimal?       @db.Decimal(5, 2)
  fixedPrice    Decimal?         @db.Decimal(12, 2)
  isActive      Boolean          @default(true)
  startsAt      DateTime?
  endsAt        DateTime?
  items         BundleDealItem[]
  createdAt     DateTime         @default(now())
  updatedAt     DateTime         @updatedAt

  @@index([isActive])
}

model BundleDealItem {
  id        String     @id @default(cuid())
  bundleId  String
  bundle    BundleDeal @relation(fields: [bundleId], references: [id], onDelete: Cascade)
  productId String
  product   Product    @relation(fields: [productId], references: [id], onDelete: Cascade)
  quantity  Int        @default(1)

  @@unique([bundleId, productId])
}

model Banner {
  id          String   @id @default(cuid())
  title       String
  placement   String
  imageUrl    String
  targetUrl   String?
  altText     String?
  mobileImageUrl String?
  sortOrder   Int      @default(0)
  isActive    Boolean  @default(true)
  startsAt    DateTime?
  endsAt      DateTime?
  createdById String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([placement, isActive, sortOrder])
}

model LoyaltyConfig {
  id                  String     @id @default(cuid())
  pointsPerCurrency   Decimal    @default(0.01) @db.Decimal(8, 4)
  pointsToCurrency    Decimal    @default(1) @db.Decimal(8, 4)
  redeemMinPoints     Int        @default(100)
  maxRedeemPercent    Decimal    @default(20) @db.Decimal(5, 2)
  coinsEnabled        Boolean    @default(true)
  cashbackPercent     Decimal    @default(0) @db.Decimal(5, 2)
  cashbackCategories  String[]
  updatedAt           DateTime   @updatedAt
}

model LoyaltyLedger {
  id          String     @id @default(cuid())
  userId      String
  user        User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  points      Int
  type        RewardType
  reason      String
  referenceType ReferenceEntityType?
  referenceId String?
  balanceAfter Int
  createdAt   DateTime   @default(now())

  @@index([userId, createdAt])
}

model ReferralConfig {
  id             String   @id @default(cuid())
  isActive       Boolean  @default(true)
  rewardType     RewardType @default(POINTS)
  referrerReward Int      @default(500)
  refereeReward  Int      @default(500)
  minOrderAmount Decimal  @default(0) @db.Decimal(12, 2)
  maxRewardsPerUser Int   @default(50)
  updatedAt      DateTime @updatedAt
}

model ReferralReward {
  id            String   @id @default(cuid())
  referrerId    String
  referrer      User     @relation("ReferralReferrer", fields: [referrerId], references: [id])
  refereeId     String
  referee       User     @relation("ReferralReferee", fields: [refereeId], references: [id])
  code          String
  rewardAmount  Int
  grantedAt     DateTime?
  orderTriggeredId String?
  createdAt     DateTime @default(now())

  @@unique([referrerId, refereeId])
  @@index([code])
}

model SponsoredListing {
  id             String               @id @default(cuid())
  sellerId       String
  seller         SellerProfile        @relation(fields: [sellerId], references: [id])
  productId      String
  product        Product              @relation(fields: [productId], references: [id])
  placement      String
  bidAmount      Decimal              @db.Decimal(12, 2)
  billingCycle   String               @default("WEEKLY")
  startDate      DateTime
  endDate        DateTime
  paymentStatus  SponsoredPaymentStatus @default(UNPAID)
  paymentId      String?
  impressions    Int                  @default(0)
  clicks         Int                  @default(0)
  isActive       Boolean              @default(true)
  approvedById   String?
  createdAt      DateTime             @default(now())
  updatedAt      DateTime             @updatedAt

  @@index([productId, isActive])
  @@index([placement, isActive, endDate])
}

// ─────────────────────────── SEARCH & DISCOVERY ───────────────────────────

model SearchQuery {
  id          String   @id @default(cuid())
  userId      String?
  user        User?    @relation(fields: [userId], references: [id])
  query       String
  normalized  String
  resultsCount Int     @default(0)
  clickedProductId String?
  createdAt   DateTime @default(now())

  @@index([normalized, createdAt])
  @@index([createdAt])
}

model ProductView {
  id        String   @id @default(cuid())
  userId    String?
  user      User?    @relation(fields: [userId], references: [id])
  productId String
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  sessionId String?
  referrer  String?
  createdAt DateTime @default(now())

  @@index([userId, createdAt])
  @@index([productId])
}

// ─────────────────────────── REVIEWS ───────────────────────────

model Review {
  id              String          @id @default(cuid())
  productId       String?
  product         Product?        @relation(fields: [productId], references: [id], onDelete: Cascade)
  sellerId        String?
  shopId          String?
  orderItemId     String?         @unique
  buyerId         String
  buyer           User            @relation(fields: [buyerId], references: [id])
  rating          Int
  title           String?
  body            String?
  isVerified      Boolean         @default(false)
  isVisible       Boolean         @default(true)
  isReported      Boolean         @default(false)
  reportReason    String?
  reportedById    String?
  sellerReply     String?
  sellerRepliedAt DateTime?
  aiSummary       String?
  sentiment       Json?
  helpfulVotes    ReviewHelpful[]
  media           ReviewMedia[]
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt

  @@index([productId, isVisible, createdAt])
  @@index([sellerId])
  @@index([buyerId])
  @@index([isReported])
}

model ReviewHelpful {
  id        String   @id @default(cuid())
  reviewId  String
  review    Review   @relation(fields: [reviewId], references: [id], onDelete: Cascade)
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  isHelpful Boolean  @default(true)
  createdAt DateTime @default(now())

  @@unique([reviewId, userId])
}

model ReviewMedia {
  id        String   @id @default(cuid())
  reviewId  String
  review    Review   @relation(fields: [reviewId], references: [id], onDelete: Cascade)
  uploaderId String
  uploader  User     @relation(fields: [uploaderId], references: [id])
  url       String
  type      String   @default("IMAGE")
  position  Int      @default(0)
  createdAt DateTime @default(now())

  @@index([reviewId])
}

// ─────────────────────────── WISHLIST ───────────────────────────

model WishlistItem {
  id             String    @id @default(cuid())
  userId         String
  user           User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  productId      String
  product        Product   @relation(fields: [productId], references: [id], onDelete: Cascade)
  addedAt        DateTime  @default(now())
  priceAtAdd     Decimal   @db.Decimal(12, 2)
  lastNotifiedAt DateTime?

  @@unique([userId, productId])
  @@index([userId])
}

// ─────────────────────────── NOTIFICATIONS ───────────────────────────

model Notification {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  type      String
  title     String
  body      String?
  actionUrl String?
  channel   NotificationChannel @default(IN_APP)
  audience  NotificationAudience @default(BUYER)
  data      Json?
  isRead    Boolean  @default(false)
  readAt    DateTime?
  createdAt DateTime @default(now())

  @@index([userId, isRead, createdAt])
}

model NotificationPreference {
  id          String   @id @default(cuid())
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  typeKey     String
  inApp       Boolean  @default(true)
  email       Boolean  @default(true)
  push        Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@unique([userId, typeKey])
}

model PushSubscription {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  endpoint  String   @unique
  keys      Json
  userAgent String?
  createdAt DateTime @default(now())

  @@index([userId])
}

// ─────────────────────────── SUPPORT & AI ───────────────────────────

model SupportTicket {
  id            String         @id @default(cuid())
  ticketNumber  String         @unique
  creatorId     String
  creator       User           @relation("TicketCreator", fields: [creatorId], references: [id])
  assignedToId  String?
  assignedTo    User?          @relation("TicketAssignee", fields: [assignedToId], references: [id])
  type          TicketType
  subject       String
  description   String
  status        TicketStatus   @default(OPEN)
  priority      TicketPriority @default(MEDIUM)
  orderId       String?
  subOrderId    String?
  productId     String?
  sellerUserId  String?
  resolution    String?
  resolvedAt    DateTime?
  flags         String[]
  notes         String?
  messages      TicketMessage[]
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt

  @@index([status, priority])
  @@index([creatorId])
  @@index([assignedToId, status])
}

model TicketMessage {
  id        String        @id @default(cuid())
  ticketId  String
  ticket    SupportTicket @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  authorId  String
  author    User          @relation(fields: [authorId], references: [id])
  body      String
  attachments Json?
  isInternal Boolean      @default(false)
  isCanned  Boolean       @default(false)
  createdAt DateTime      @default(now())

  @@index([ticketId, createdAt])
}

model CannedResponse {
  id        String   @id @default(cuid())
  title     String
  body      String
  category  String?
  useCount  Int      @default(0)
  createdById String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model AiChatSession {
  id        String   @id @default(cuid())
  userId    String?
  user      User?    @relation(fields: [userId], references: [id])
  guestId   String?
  topic     String?
  context   Json?
  messages  Json[]
  rating    Int?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId, updatedAt])
}

model FraudAlert {
  id           String       @id @default(cuid())
  subjectType  FraudSubject
  subjectId    String
  signal       String
  score        Decimal      @db.Decimal(5, 2)
  details      Json?
  status       FraudStatus  @default(FLAGGED)
  reviewedById String?
  reviewedAt   DateTime?
  actionTaken  String?
  createdAt    DateTime     @default(now())

  @@index([status, createdAt])
  @@index([subjectType, subjectId])
}

// ─────────────────────────── PLATFORM & AUDIT ───────────────────────────

model Settings {
  id                  String   @id @default("platform")
  platformName        String   @default("MarketPlace")
  platformLogoUrl     String?
  currency            String   @default("LKR")
  currencySymbol      String    @default("Rs")
  locale              String   @default("en")
  defaultCommissionPercent Decimal @default(8) @db.Decimal(5, 2)
  returnWindowDays    Int      @default(7)
  codEnabled          Boolean  @default(true)
  codMaxAmount        Decimal? @db.Decimal(14, 2)
  installmentsEnabled Boolean  @default(true)
  installmentPlans    Json?
  minPayoutAmount     Decimal  @default(1000) @db.Decimal(14, 2)
  freeShippingThreshold Decimal @default(5000) @db.Decimal(12, 2)
  flatShippingFee     Decimal  @default(250) @db.Decimal(12, 2)
  taxPercent          Decimal  @default(0) @db.Decimal(5, 2)
  aiEnabled           Boolean  @default(true)
  maintenanceMode     Boolean  @default(false)
  supportEmail        String   @default("support@marketplace.local")
  updatedAt           DateTime @updatedAt
}

model PlatformAnnouncement {
  id          String   @id @default(cuid())
  title       String
  body        String
  placement   AnnouncementPlacement @default(SITE_WIDE_BANNER)
  bgColor     String?
  textColor   String?
  ctaLabel    String?
  ctaUrl      String?
  isActive    Boolean  @default(true)
  startsAt    DateTime?
  endsAt      DateTime?
  createdById String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([isActive, placement])
}

model AuditLog {
  id        String          @id @default(cuid())
  actorId   String
  actor     User            @relation(fields: [actorId], references: [id])
  action    String
  entityType AuditEntityType
  entityId  String?
  before    Json?
  after     Json?
  ip        String?
  userAgent String?
  createdAt DateTime        @default(now())

  @@index([entityType, entityId])
  @@index([actorId, createdAt])
}

model ScheduledJobRun {
  id        String   @id @default(cuid())
  key       String   @unique
  lastRunAt DateTime
  result    Json?
  createdAt DateTime @default(now())

  @@index([key])
}
