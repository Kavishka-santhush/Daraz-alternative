# ── Runtime ────────────────────────────────────────────────────
NODE_ENV=development
PORT=5000
# Public URLs of the two apps (used for CORS, email links, OAuth redirects).
WEB_URL=http://localhost:3000
API_URL=http://localhost:5000

# ── Database (PostgreSQL) ──────────────────────────────────────
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/marketplace?schema=public

# ── Auth / JWT ─────────────────────────────────────────────────
# Generate each with: openssl rand -base64 32
JWT_SECRET=change-me-access-secret
JWT_REFRESH_SECRET=change-me-refresh-secret
JWT_ACCESS_EXPIRES=15m
JWT_REFRESH_EXPIRES=30d

# ── Stripe (card + installments + payouts) ─────────────────────
STRIPE_SECRET_KEY=sk_test_placeholder
STRIPE_WEBHOOK_SECRET=whsec_placeholder

# ── AI (OpenRouter) ────────────────────────────────────────────
OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_MODEL=openai/gpt-4o

# ── Local file uploads (Multer disk storage) ───────────────────
UPLOAD_DIR=uploads
MAX_FILE_SIZE_MB=10

# ── Email (Nodemailer / SMTP) ──────────────────────────────────
SMTP_HOST=smtp.mailtrap.io
SMTP_PORT=2525
SMTP_USER=
SMTP_PASS=
EMAIL_FROM=Marketplace <no-reply@marketplace.local>

# ── Web Push (VAPID) ───────────────────────────────────────────
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:admin@marketplace.local

# ── Business rules ─────────────────────────────────────────────
DEFAULT_COMMISSION_PERCENT=8
SELLER_CONFIRM_TIMEOUT_HOURS=24
RETURN_WINDOW_DAYS=7
CURRENCY=LKR
LOW_STOCK_ALERT_THRESHOLD=5
